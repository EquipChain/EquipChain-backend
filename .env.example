# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Host address the HTTP server binds to.
HOST=0.0.0.0
# Whole-request budget in ms; requests exceeding it are terminated.
# (Server default: 30000. Node caps shutdown at SHUTDOWN_TIMEOUT_MS.)
SHUTDOWN_TIMEOUT_MS=10000

# ─── Blockchain ──────────────────────────────────────────────────────────────
CONTRACT_ID=CB7PSJZALNWNX7NLOAM6LOEL4OJZMFPQZJMIYO522ZSACYWXTZIDEDSS
# Soroban RPC endpoint for real on-chain reads. Unset = mock mode (simulated
# data) so dev/test work with zero chain infrastructure.
SOROBAN_RPC_URL=
# Force mock mode even when SOROBAN_RPC_URL is set (1 = mock).
SOROBAN_USE_MOCK=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Security ────────────────────────────────────────────────────────────────
# REQUIRED in production (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Development convenience: allow /api/auth/challenge (token minting without
# wallet-signature proof) in production. Leave false.
ENABLE_DEV_CHALLENGE=false
# Maximum request body size (e.g. '1mb', '500kb'). Invalid values fail boot.
MAX_BODY_SIZE=1mb
# Reverse-proxy awareness for req.ip (rate limiting, logging). Keep `false`
# when the app is exposed directly - a client could otherwise spoof
# X-Forwarded-For to evade per-IP limits. Set `true` (or a hop count like 1,
# or a subnet) when running behind nginx/ALB/Cloudflare.
TRUST_PROXY=false

# ─── CORS ────────────────────────────────────────────────────────────────────
# * allows all origins (development default). For production list exact
# origins, comma-separated: https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# ─── Metrics ─────────────────────────────────────────────────────────────────
# Optional bearer token required by scrapers hitting /metrics. Empty = open
# endpoint (fine inside a private cluster network).
METRICS_TOKEN=

# ─── Caching (Redis) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Meter readings store ────────────────────────────────────────────────────
# Retention window for stored readings in days (the sweeper drops older data).
READINGS_RETENTION_DAYS=90
# Global cap on stored readings; the oldest readings are evicted when hit.
MAX_TOTAL_READINGS=500000

# ─── Job queue ───────────────────────────────────────────────────────────────
JOB_CONCURRENCY=5
JOB_RETRY_ATTEMPTS=3
JOB_BATCH_SIZE=10
# Durability: empty = in-memory only (restarts drop queued work). Set to a
# file path on a persistent volume to snapshot queue state (debounced,
# atomic temp-file+rename writes). On boot the queue recovers: queued jobs
# resume, running jobs are re-queued, delayed jobs re-arm their remaining wait.
QUEUE_PERSIST_PATH=
# Snapshot flush window in ms (coalesces bursty state changes).
QUEUE_PERSIST_FLUSH_MS=250
# How long close() waits for in-flight jobs before giving up (ms). Jobs still
# running at the deadline are safe: recovery re-queues RUNNING on next boot.
QUEUE_DRAIN_TIMEOUT_MS=5000

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Upper bound on tracked rate-limit counter keys (memory-exhaustion guard).
RATE_LIMIT_MAX_KEYS=100000

# ─── Deployment identity (optional) ─────────────────────────────────────────────
# Reported in GET /health (gitSha, deployedAt) when set by your deploy tooling.
GIT_SHA=
# ISO-8601 timestamp of the deployment.
DEPLOY_TIME=

# ─── OpenTelemetry ───────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=equipchain-api
# OTLP collector endpoint for trace export, e.g. http://localhost:4318
# (read by the OpenTelemetry SDK's standard env convention)
OTEL_EXPORTER_OTLP_ENDPOINT=
